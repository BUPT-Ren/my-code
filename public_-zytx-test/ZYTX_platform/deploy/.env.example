# ===========================================
# ZYTX Platform 生产环境配置模板
# ===========================================
# 使用方法：
# 1. 复制此文件为 .env
#    cp deploy/.env.example .env
# 2. 修改下面的配置项
# 3. 确保 .env 不会被提交到 Git
# ===========================================

# ===================
# MySQL 配置
# ===================
# MySQL root 用户密码（强密码，建议 16 位以上）
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# 应用数据库用户名
DB_USER=zytx_user

# 应用数据库密码（强密码，建议 16 位以上）
DB_PASSWORD=your_strong_password_here

# ===================
# Flask 应用配置
# ===================
# Flask 密钥（用于 session 加密等，生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=your_production_secret_key_here_generate_with_python_secrets

# ===================
# AI 服务配置
# ===================
# DeepSeek API Key（从 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ===================
# 管理员配置
# ===================
# 管理员注册密钥（注册管理员账号时需要输入）
ADMIN_REGISTER_KEY=ZYTX_ADMIN_2024_SECRET

# ===================
# 可选配置
# ===================
# 时区
TZ=Asia/Shanghai