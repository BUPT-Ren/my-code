/* app.wxss - 全局样式 */

/* 字体引入 - 使用系统字体作为备选 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', 'Helvetica Neue', sans-serif;
  background-color: #F5F8FA;
  color: #2D2D2D;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 全局颜色变量 - 浅蓝白色系 */
page {
  --primary: #5B8DEF;
  --secondary: #F5F8FA;
  --accent: #5BCCF4;
  --text-main: #2D2D2D;
  --text-secondary: #6B6B6B;
  --border: #E8EEF5;
  --success: #5BDA95;
  --warning: #FFB55B;
  --white: #FFFFFF;
  --shadow-light: rgba(91, 141, 239, 0.08);
  --shadow-medium: rgba(91, 141, 239, 0.15);
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--shadow-light);
  margin-bottom: 24rpx;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, #6B9CF1 100%);
  color: var(--white);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-secondary {
  background: var(--white);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 16rpx;
  padding: 22rpx 46rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn-accent {
  background: linear-gradient(135deg, var(--accent) 0%, #6BD8FF 100%);
  color: var(--white);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

/* 输入框样式 */
.input-field {
  background: var(--secondary);
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--primary);
}

/* 标题样式 */
.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.title-page {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.title-card {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

/* 文字样式 */
.text-secondary {
  color: var(--text-secondary);
}

.text-accent {
  color: var(--accent);
}

.text-success {
  color: var(--success);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(91, 141, 239, 0.1);
  color: var(--primary);
}

.tag-accent {
  background: rgba(91, 204, 244, 0.15);
  color: var(--accent);
}

.tag-success {
  background: rgba(91, 218, 149, 0.15);
  color: var(--success);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

/* Flex 工具类 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeIn 0.4s ease forwards;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.pulse {
  animation: pulse 0.3s ease;
}

/* 列表项动画延迟 */
.stagger-1 { animation-delay: 0.05s; }
.stagger-2 { animation-delay: 0.1s; }
.stagger-3 { animation-delay: 0.15s; }
.stagger-4 { animation-delay: 0.2s; }
.stagger-5 { animation-delay: 0.25s; }
.stagger-6 { animation-delay: 0.3s; }