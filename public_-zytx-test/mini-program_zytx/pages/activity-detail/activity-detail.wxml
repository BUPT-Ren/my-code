<view class="page">
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <view class="activity-detail" wx:elif="{{activity}}">
    <view class="cover-section" wx:if="{{activity.cover_image}}">
      <image class="cover-image" src="http://47.93.172.18{{activity.cover_image}}" mode="aspectFill"></image>
    </view>

    <view class="header-section">
      <text class="title">{{activity.title}}</text>
      <view class="status-tag {{activity.status}}">
        <text wx:if="{{activity.status === 'published'}}">报名中</text>
        <text wx:elif="{{activity.status === 'ongoing'}}">进行中</text>
        <text wx:else>已结束</text>
      </view>
    </view>

    <view class="info-section">
      <view class="info-card">
        <view class="info-row">
          <text class="info-icon">📅</text>
          <view class="info-content">
            <text class="info-label">活动时间</text>
            <text class="info-value">{{activity.start_time_str || '-'}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-icon">🏁</text>
          <view class="info-content">
            <text class="info-label">结束时间</text>
            <text class="info-value">{{activity.end_time_str || '-'}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-icon">📍</text>
          <view class="info-content">
            <text class="info-label">活动地点</text>
            <text class="info-value">{{activity.location || '待定'}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-icon">👥</text>
          <view class="info-content">
            <text class="info-label">报名人数</text>
            <text class="info-value">{{activity.approved_count || 0}} / {{activity.max_participants || '不限'}}</text>
          </view>
        </view>
        <view class="info-row" wx:if="{{activity.registration_start_time_str}}">
          <text class="info-icon">📝</text>
          <view class="info-content">
            <text class="info-label">报名开始</text>
            <text class="info-value">{{activity.registration_start_time_str}}</text>
          </view>
        </view>
        <view class="info-row" wx:if="{{activity.registration_end_time_str}}">
          <text class="info-icon">⏰</text>
          <view class="info-content">
            <text class="info-label">报名截止</text>
            <text class="info-value">{{activity.registration_end_time_str}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="register-section" wx:if="{{activity.status === 'published' || activity.status === 'ongoing'}}">
      <view wx:if="{{registration && registration.status === 'pending'}}" class="register-box pending">
        <text class="register-title">审核中</text>
        <text class="register-desc">您的报名申请正在审核中，请耐心等待</text>
        <button class="btn-cancel" bindtap="onCancelRegister">取消报名</button>
      </view>

      <view wx:elif="{{registration && registration.status === 'approved'}}" class="register-box approved">
        <text class="register-title">报名成功</text>
        <text class="register-desc">您已成功报名该活动</text>
        <button class="btn-cancel" bindtap="onCancelRegister">取消报名</button>
      </view>

      <view wx:elif="{{registration && registration.status === 'rejected'}}" class="register-box rejected">
        <text class="register-title">报名未通过</text>
        <text class="register-desc">您的报名申请未通过审核</text>
        <button class="btn-register" bindtap="onRegister">重新报名</button>
      </view>

      <view wx:elif="{{activity.approved_count >= activity.max_participants}}" class="register-box full">
        <text class="register-title">已满员</text>
        <text class="register-desc">该活动报名人数已满</text>
      </view>

      <view wx:elif="{{!isLoggedIn}}" class="register-box">
        <text class="register-title">立即报名参与</text>
        <text class="register-desc">请先登录后报名</text>
        <button class="btn-register" bindtap="onRegister">去登录</button>
      </view>

      <view wx:else class="register-box">
        <text class="register-title">立即报名参与</text>
        <text class="register-desc">名额有限，先到先得</text>
        <button class="btn-register" bindtap="onRegister">立即报名</button>
      </view>
    </view>

    <view class="desc-section">
      <text class="section-title">活动详情</text>
      <view class="desc-content">
        <text>{{activity.description || '暂无详情'}}</text>
      </view>
    </view>

    <view class="summary-section" wx:if="{{activity.summary}}">
      <text class="section-title">活动总结</text>
      <view class="summary-content">
        <text>{{activity.summary.content}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <text>活动不存在</text>
  </view>
</view>