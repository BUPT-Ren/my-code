.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #6B6B6B;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.activity-detail {
  padding: 0;
}

.cover-section {
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.header-section {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2D2D;
  line-height: 1.4;
  margin-right: 16rpx;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.status-tag.published {
  background: rgba(91, 218, 149, 0.15);
  color: #5BDA95;
}

.status-tag.ongoing {
  background: rgba(91, 141, 239, 0.15);
  color: #5B8DEF;
}

.status-tag.ended {
  background: #F5F5F5;
  color: #9E9E9E;
}

.info-section {
  padding: 24rpx 32rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F8FA;
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #9B9B9B;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #2D2D2D;
  font-weight: 500;
}

.register-section {
  padding: 24rpx 32rpx;
}

.register-box {
  background: linear-gradient(135deg, #5B8DEF 0%, #6B9CF1 100%);
  padding: 40rpx;
  border-radius: 20rpx;
  text-align: center;
  color: #FFFFFF;
}

.register-box.pending {
  background: linear-gradient(135deg, #FFB55B 0%, #FFC56B 100%);
}

.register-box.approved {
  background: linear-gradient(135deg, #5BDA95 0%, #6BE5A5 100%);
}

.register-box.rejected {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8A8A 100%);
}

.register-box.full {
  background: #C0C0C0;
}

.register-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.register-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.btn-register {
  background: #FFFFFF;
  color: #5B8DEF;
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.desc-section,
.summary-section {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  margin: 0 32rpx 24rpx;
  border-radius: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #5B8DEF;
}

.desc-content,
.summary-content {
  font-size: 28rpx;
  color: #6B6B6B;
  line-height: 1.8;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #9E9E9E;
  font-size: 28rpx;
}