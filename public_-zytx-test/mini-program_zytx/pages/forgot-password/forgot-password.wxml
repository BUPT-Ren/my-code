<view class="page">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text>‹</text>
    </view>
    <text class="title">找回密码</text>
    <view class="placeholder"></view>
  </view>

  <view class="content">
    <view class="icon-section">
      <text class="icon">🔑</text>
      <text class="subtitle">密码重置申请</text>
      <text class="desc">请输入您的手机号，管理员将处理您的密码重置申请</text>
    </view>

    <view class="form-section">
      <view class="input-group">
        <text class="input-label">📱 手机号</text>
        <input 
          class="input-field" 
          type="number"
          maxlength="11"
          placeholder="请输入注册手机号" 
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="input-group">
        <text class="input-label">📝 申请原因</text>
        <textarea 
          class="textarea-field" 
          placeholder="如有需要请填写申请原因（可选）" 
          placeholder-class="input-placeholder"
          value="{{reason}}"
          bindinput="onReasonInput"
          maxlength="200"
        />
      </view>

      <button class="btn-submit" bindtap="onSubmit" disabled="{{loading}}">
        {{loading ? '提交中...' : '提交申请'}}
      </button>
    </view>

    <view class="tips-section">
      <text class="tips-title">温馨提示</text>
      <text class="tips-item">• 申请提交后，管理员将审核您的请求</text>
      <text class="tips-item">• 审核通过后，密码将被重置为默认密码</text>
      <text class="tips-item">• 您可以联系管理员加急处理</text>
    </view>
  </view>
</view>