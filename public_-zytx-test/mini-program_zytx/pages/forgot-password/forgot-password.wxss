.page {
  min-height: 100vh;
  background: #F5F8FA;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(91, 141, 239, 0.08);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn text {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 300;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.placeholder {
  width: 60rpx;
}

.content {
  padding: 32rpx;
}

.icon-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 36rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #6B6B6B;
  text-align: center;
  padding: 0 40rpx;
}

.form-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #F5F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2D2D2D;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  height: 160rpx;
  background: #F5F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2D2D2D;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9B9B9B;
}

.btn-submit {
  background: linear-gradient(135deg, #5B8DEF 0%, #6B9CF1 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
}

.btn-submit[disabled] {
  opacity: 0.6;
}

.tips-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #6B6B6B;
  line-height: 2;
}