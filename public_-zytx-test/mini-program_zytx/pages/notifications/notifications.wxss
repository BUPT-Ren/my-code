.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(91, 141, 239, 0.08);
}

.header-left {
  width: 60rpx;
}

.header-right {
  min-width: 60rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 300;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.mark-read {
  font-size: 24rpx;
  color: #5B8DEF;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B6B6B;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #6B6B6B;
  font-size: 28rpx;
}

.unread-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  color: #5B8DEF;
  font-size: 24rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  background: #5B8DEF;
  border-radius: 50%;
}

.notification-list {
  padding: 0 32rpx;
}

.notification-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
  position: relative;
}

.notification-item.unread {
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F8FA 100%);
}

.notification-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notification-icon text {
  font-size: 36rpx;
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  flex: 1;
  margin-right: 16rpx;
}

.notification-time {
  font-size: 22rpx;
  color: #9B9B9B;
  flex-shrink: 0;
}

.notification-text {
  font-size: 24rpx;
  color: #6B6B6B;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notification-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  background: #FF6B6B;
  border-radius: 50%;
}