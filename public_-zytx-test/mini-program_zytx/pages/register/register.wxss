.register-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f8fa 100%);
  padding: 60rpx 60rpx;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #2d2d2d;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #9e9e9e;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f8fa;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.input-icon {
  font-size: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-field {
  flex: 1;
  height: 88rpx;
  padding-right: 24rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9B9B9B;
}

.toggle-pwd {
  font-size: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement {
  margin: 20rpx 0;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 24rpx;
  color: #6b6b6b;
  margin-left: 8rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #5b8def;
}

.btn-register {
  background: linear-gradient(135deg, #5b8def, #667eea);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.btn-register[disabled] {
  background: #ccc;
}

.login-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #6b6b6b;
}

.link {
  color: #5b8def;
  margin-left: 10rpx;
  font-weight: 500;
}