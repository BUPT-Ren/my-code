.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(91, 141, 239, 0.08);
}

.header-left,
.header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 300;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B6B6B;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #6B6B6B;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  color: #FFFFFF;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.count-bar {
  padding: 20rpx 32rpx;
  color: #6B6B6B;
  font-size: 24rpx;
}

.favorites-list {
  padding: 0 32rpx;
}

.fav-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.fav-cover {
  width: 140rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-color {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-emoji {
  font-size: 60rpx;
}

.fav-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.fav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-author {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-bottom: 8rpx;
}

.fav-meta {
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #9B9B9B;
}

.fav-status {
  margin-top: auto;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-tag.available {
  background: rgba(91, 218, 149, 0.15);
  color: #5BDA95;
}

.status-tag.unavailable {
  background: rgba(255, 181, 91, 0.15);
  color: #FFB55B;
}

.fav-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  min-width: 80rpx;
}

.borrow-btn {
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
}

.borrow-btn.disabled {
  background: #E8EEF5;
}

.borrow-btn .btn-icon,
.borrow-btn .btn-text {
  color: #FFFFFF;
}

.borrow-btn.disabled .btn-icon,
.borrow-btn.disabled .btn-text {
  color: #9B9B9B;
}

.cancel-btn {
  background: #F5F8FA;
}

.cancel-btn .btn-icon,
.cancel-btn .btn-text {
  color: #6B6B6B;
}

.btn-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.btn-text {
  font-size: 20rpx;
}