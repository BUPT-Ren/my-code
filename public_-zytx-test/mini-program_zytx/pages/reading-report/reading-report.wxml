<!--pages/reading-report/reading-report.wxml-->
<view class="page">
  <!-- 顶部数据总览 -->
  <view class="overview-card">
    <view class="overview-header">
      <text class="overview-title">阅读数据总览</text>
      <text class="overview-subtitle">2024年</text>
    </view>
    <view class="overview-stats">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalBooks}}</text>
        <text class="stat-label">阅读总数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.readingTime}}</text>
        <text class="stat-label">阅读时长(h)</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.avgSpeed || 2.5}}</text>
        <text class="stat-label">本周阅读(本)</text>
      </view>
    </view>
  </view>

  <!-- 阅读偏好雷达 -->
  <view class="section-card">
    <view class="section-title">阅读偏好</view>
    <view class="radar-simple">
      <view class="radar-item" wx:for="{{radarData}}" wx:key="name">
        <text class="radar-name">{{item.name}}</text>
        <view class="radar-bar">
          <view class="radar-fill" style="width: {{item.value}}%"></view>
        </view>
        <text class="radar-value">{{item.value}}%</text>
      </view>
    </view>
  </view>

  <!-- 分类分布 -->
  <view class="section-card">
    <view class="section-title">阅读分类分布</view>
    <view class="category-bars">
      <view 
        wx:for="{{categoryData}}" 
        wx:key="name" 
        class="category-bar-item"
      >
        <view class="bar-info">
          <text class="bar-name">{{item.name}}</text>
          <text class="bar-count">{{item.value}}本</text>
        </view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.percentage}}%"></view>
        </view>
        <text class="bar-percentage">{{item.percentage}}%</text>
      </view>
    </view>
  </view>

  <!-- 阅读洞察 -->
  <view class="section-card insight-card">
    <view class="section-title">📊 阅读洞察</view>
    <text class="insight-text">{{readingInsights}}</text>
  </view>

  <!-- 推荐书籍 -->
  <view class="section-card">
    <view class="section-title">为你推荐</view>
    <view class="recommend-list">
      <view 
        wx:for="{{recommendations}}" 
        wx:key="id" 
        class="recommend-item"
        bindtap="onBookTap"
        data-id="{{item.id}}"
      >
        <view class="recommend-cover-color" style="background: {{item.coverColor || '#5B8DEF'}};">
          <text class="cover-emoji">📗</text>
        </view>
        <view class="recommend-info">
          <text class="recommend-title">{{item.title}}</text>
          <text class="recommend-author">{{item.author}}</text>
          <view class="recommend-rating">
            <text class="star">★</text>
            <text>{{item.rating}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>