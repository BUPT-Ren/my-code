/* pages/reading-report/reading-report.wxss */

.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding: 24rpx 32rpx 120rpx;
}

/* 顶部数据总览 */
.overview-card {
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 115, 85, 0.2);
}

.overview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.overview-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.overview-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 区块卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 115, 85, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #5B8DEF;
}

/* 简化版阅读偏好 */
.radar-simple {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radar-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radar-name {
  width: 80rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.radar-bar {
  flex: 1;
  height: 20rpx;
  background: #F5F8FA;
  border-radius: 10rpx;
  overflow: hidden;
}

.radar-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF 0%, #5BCCF4 100%);
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.radar-value {
  width: 60rpx;
  font-size: 22rpx;
  color: #5B8DEF;
  font-weight: 600;
  text-align: right;
}

/* 分类分布 */
.category-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-bar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bar-info {
  width: 120rpx;
  display: flex;
  flex-direction: column;
}

.bar-name {
  font-size: 24rpx;
  color: #2D2D2D;
}

.bar-count {
  font-size: 20rpx;
  color: #9B9B9B;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: #F5F8FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF 0%, #5BCCF4 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.bar-percentage {
  width: 70rpx;
  font-size: 24rpx;
  color: #5B8DEF;
  font-weight: 600;
  text-align: right;
}

/* 阅读洞察 */
.insight-card {
  background: linear-gradient(135deg, #FFF9F5 0%, #FFFFFF 100%);
}

.insight-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #2D2D2D;
  white-space: pre-wrap;
}

/* 推荐列表 */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #F5F8FA;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.recommend-item:active {
  background: #EDF2F7;
}

.recommend-cover-color {
  width: 80rpx;
  height: 110rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recommend-cover-color .cover-emoji {
  font-size: 32rpx;
}

.recommend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.recommend-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 4rpx;
}

.recommend-author {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-bottom: 8rpx;
}

.recommend-rating {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #5BCCF4;
}

.recommend-rating .star {
  margin-right: 4rpx;
}