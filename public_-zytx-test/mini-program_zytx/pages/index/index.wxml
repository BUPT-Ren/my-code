<!--pages/index/index.wxml-->
<view class="page">
  <!-- 顶部搜索区域 -->
  <view class="search-area">
    <view class="search-box">
      <text class="search-icon-text">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索书名、作者、分类..." 
        placeholder-class="search-placeholder"
        value="{{searchValue}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchValue}}" bindtap="onSearchClear">
        <text>×</text>
      </view>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="category-list">
      <view 
        wx:for="{{categories}}" 
        wx:key="index" 
        class="category-item {{activeCategory === index ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-index="{{index}}"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 轮播推荐位 -->
  <swiper class="banner-swiper" indicator-dots="true" indicator-color="rgba(91,141,239,0.3)" indicator-active-color="#5B8DEF" autoplay="true" interval="4000" circular="true">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" bindtap="goToActivity">
        <view class="banner-content">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-desc">{{item.desc}}</text>
        </view>
        <view class="banner-decoration"></view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 热门推荐标题 -->
  <view class="section-header">
    <text class="section-title">热门推荐</text>
  </view>

  <!-- 图书列表 -->
  <view class="book-grid">
    <view 
      wx:for="{{books}}" 
      wx:key="id" 
      class="book-card fade-in stagger-{{index % 6 + 1}}"
      bindtap="onBookTap"
      data-id="{{item.id}}"
    >
      <view class="book-cover-wrap">
        <!-- 使用颜色块作为封面 -->
        <view class="book-cover-color" style="background: {{item.coverColor}};">
          <text class="cover-emoji">{{index % 2 === 0 ? '📕' : '📗'}}</text>
        </view>
        <view class="book-available" wx:if="{{item.available > 0}}">
          <text>可借</text>
        </view>
        <view class="book-unavailable" wx:else>
          <text>已借完</text>
        </view>
        <!-- 收藏按钮 -->
        <view class="favorite-btn {{item.isFavorited ? 'favorited' : ''}}" catchtap="onQuickFavorite" data-id="{{item.id}}">
          <text class="heart-icon">{{item.isFavorited ? '♥' : '♡'}}</text>
        </view>
      </view>
      <view class="book-info">
        <text class="book-title">{{item.title}}</text>
        <text class="book-author">{{item.author}}</text>
        <view class="book-meta">
          <view class="book-rating">
            <text class="star">★</text>
            <text>{{item.rating}}</text>
          </view>
          <text class="book-category tag">{{item.category}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{books.length === 0}}">
    <text class="empty-icon">📚</text>
    <text class="empty-text">没有找到相关图书</text>
    <view class="empty-action" bindtap="onSearchClear">
      <text>清除搜索</text>
    </view>
  </view>
</view>