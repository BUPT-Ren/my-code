.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 120rpx;
}

.type-filter {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-item {
  padding: 12rpx 32rpx;
  background: #F5F8FA;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6B6B6B;
}

.filter-item.active {
  background: #5B8DEF;
  color: #FFFFFF;
}

.activity-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.card-header {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}

.card-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background: linear-gradient(135deg, #EDF2F7 0%, #E8EEF5 100%);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-icon {
  font-size: 48rpx;
  opacity: 0.5;
}

.status-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #FFFFFF;
}

.status-badge.published {
  background: #5BDA95;
}

.status-badge.ongoing {
  background: #5B8DEF;
}

.status-badge.ended {
  background: #9B9B9B;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 22rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #6B6B6B;
}

.card-body {
  padding: 0 20rpx 20rpx;
  border-top: 1rpx solid #F5F8FA;
  padding-top: 16rpx;
}

.time-info {
  display: flex;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-label {
  font-size: 22rpx;
  color: #9B9B9B;
}

.time-value {
  font-size: 22rpx;
  color: #2D2D2D;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.register-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
  font-weight: 500;
}

.register-btn.available {
  background: linear-gradient(135deg, #5B8DEF 0%, #6B9CF1 100%);
  color: #FFFFFF;
}

.register-btn.registered {
  background: rgba(91, 218, 149, 0.15);
  color: #5BDA95;
}

.register-btn.pending {
  background: rgba(255, 181, 91, 0.15);
  color: #FFB55B;
}

.register-btn.full {
  background: #F5F8FA;
  color: #9B9B9B;
}

.register-btn.rejected {
  background: rgba(255, 107, 107, 0.15);
  color: #FF6B6B;
}

.detail-btn {
  padding: 16rpx 24rpx;
  background: #F5F8FA;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #5B8DEF;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #9B9B9B;
  font-size: 28rpx;
}

.loading-state {
  text-align: center;
  padding: 40rpx 0;
  color: #9B9B9B;
  font-size: 26rpx;
}