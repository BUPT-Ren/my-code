<view class="page">
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="header-title">借阅历史</text>
    <view class="header-right"></view>
  </view>

  <view wx:if="{{loading && historyList.length === 0}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{historyList.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无借阅历史</text>
    <view class="empty-tip">
      <text>借阅的图书将在这里显示</text>
    </view>
  </view>

  <view wx:else class="history-list">
    <view class="count-bar">
      <text>共 {{historyList.length}} 条记录</text>
    </view>

    <view 
      wx:for="{{historyList}}" 
      wx:key="record_id" 
      class="history-item"
    >
      <view class="history-cover" bindtap="onBookTap" data-id="{{item.book_id}}">
        <image 
          wx:if="{{item.cover_url}}" 
          src="{{item.cover_url}}" 
          mode="aspectFill"
          class="cover-image"
        />
        <view wx:else class="cover-color" style="background: {{item.coverColor}};">
          <text class="cover-emoji">📖</text>
        </view>
      </view>
      
      <view class="history-info">
        <text class="history-title">{{item.title}}</text>
        <text class="history-author">{{item.author || '未知作者'}}</text>
        
        <view class="history-dates">
          <view class="date-row">
            <text class="date-label">借阅</text>
            <text class="date-value">{{item.borrow_time}}</text>
          </view>
          <view class="date-row" wx:if="{{item.return_time}}">
            <text class="date-label">归还</text>
            <text class="date-value">{{item.return_time}}</text>
          </view>
        </view>
      </view>

      <view class="history-status">
        <view class="status-tag {{item.status}}">
          <text wx:if="{{item.status === 'returned'}}">已归还</text>
          <text wx:elif="{{item.status === 'borrowed'}}">借阅中</text>
          <text wx:else>{{item.status}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-more">
      <view class="loading-spinner small"></view>
      <text>加载更多...</text>
    </view>

    <view wx:if="{{!hasMore && historyList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>