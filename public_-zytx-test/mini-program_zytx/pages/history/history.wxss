.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(91, 141, 239, 0.08);
}

.header-left,
.header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 300;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B6B6B;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #6B6B6B;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.empty-tip {
  color: #9B9B9B;
  font-size: 24rpx;
}

.count-bar {
  padding: 20rpx 32rpx;
  color: #6B6B6B;
  font-size: 24rpx;
}

.history-list {
  padding: 0 32rpx;
}

.history-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.history-cover {
  width: 100rpx;
  height: 130rpx;
  border-radius: 10rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-color {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-emoji {
  font-size: 40rpx;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-author {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-bottom: 12rpx;
}

.history-dates {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-label {
  font-size: 20rpx;
  color: #9B9B9B;
  background: #F5F8FA;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.date-value {
  font-size: 20rpx;
  color: #6B6B6B;
}

.history-status {
  display: flex;
  align-items: center;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.status-tag.returned {
  background: rgba(91, 218, 149, 0.15);
  color: #5BDA95;
}

.status-tag.borrowed {
  background: rgba(91, 141, 239, 0.15);
  color: #5B8DEF;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  color: #6B6B6B;
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #9B9B9B;
  font-size: 24rpx;
}