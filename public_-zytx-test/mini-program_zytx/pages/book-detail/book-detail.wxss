/* pages/book-detail/book-detail.wxss */

.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 120rpx;
}

/* 顶部封面区域 */
.book-header {
  position: relative;
  height: 480rpx;
  overflow: hidden;
}

.book-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 颜色块封面 */
.book-cover-color {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-cover-color .cover-emoji {
  font-size: 160rpx;
  opacity: 0.9;
}

.cover-thumb-color {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.cover-emoji-small {
  font-size: 60rpx;
}

.book-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
}

.header-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 60rpx 32rpx;
  box-sizing: border-box;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.back-btn text {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 300;
}

.book-basic {
  display: flex;
  gap: 24rpx;
}

.cover-thumb {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-bottom: 20rpx;
}

.book-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.book-author {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.book-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.book-rating .star {
  color: #5BCCF4;
  font-size: 26rpx;
}

.book-rating .rating-value {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.book-rating .rating-count {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  padding: 24rpx 0;
  margin: 0 32rpx;
  border-radius: 16rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 4rpx 20rpx rgba(139, 115, 85, 0.1);
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.status-label {
  font-size: 22rpx;
  color: #9B9B9B;
}

.status-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.status-value.available {
  color: #5BDA95;
}

.status-value.unavailable {
  color: #FFB55B;
}

.status-divider {
  width: 1rpx;
  height: 50rpx;
  background: #E8EEF5;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.action-btn.secondary {
  background: #FFFFFF;
  color: #5B8DEF;
  border: 2rpx solid #E8EEF5;
}

.action-btn.secondary.favorited {
  border-color: #5BCCF4;
  color: #5BCCF4;
}

.action-btn.primary {
  background: linear-gradient(135deg, #5B8DEF 0%, #6B9CF1 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.3);
}

.action-btn.pending {
  background: linear-gradient(135deg, #FFB55B 0%, #FFC56B 100%);
  color: #FFFFFF;
}

.action-btn.disabled {
  background: #E8EEF5;
  color: #9B9B9B;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 32rpx;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #E8EEF5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #9B9B9B;
  position: relative;
}

.tab-item.active {
  color: #5B8DEF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #5B8DEF;
  border-radius: 2rpx;
}

/* Tab 内容 */
.tab-content {
  padding: 24rpx 32rpx;
}

.tab-panel {
  animation: fadeIn 0.3s ease;
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #2D2D2D;
  text-align: justify;
}

.book-detail-info {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  color: #9B9B9B;
  font-size: 26rpx;
}

.detail-value {
  color: #2D2D2D;
  font-size: 26rpx;
}

/* 目录 */
.catalog-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}

.catalog-chapter {
  color: #5B8DEF;
  font-size: 24rpx;
  width: 120rpx;
}

.catalog-title {
  color: #2D2D2D;
  font-size: 26rpx;
}

/* 评论 */
.comment-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.comment-info {
  flex: 1;
}

.comment-user {
  font-size: 26rpx;
  color: #2D2D2D;
  font-weight: 500;
}

.comment-rating {
  display: flex;
  gap: 2rpx;
  margin-top: 4rpx;
}

.comment-rating .star {
  font-size: 22rpx;
  color: #E8EEF5;
}

.comment-rating .star.filled {
  color: #5BCCF4;
}

.comment-date {
  font-size: 22rpx;
  color: #9B9B9B;
}

.comment-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #2D2D2D;
}

/* 借阅弹窗 */
.borrow-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.borrow-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.borrow-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #E8EEF5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #9B9B9B;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.borrow-book-info {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #F5F8FA;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.borrow-cover {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.borrow-cover-color {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-emoji-tiny {
  font-size: 40rpx;
}

.borrow-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.borrow-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.borrow-author {
  font-size: 24rpx;
  color: #6B6B6B;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #2D2D2D;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.date-select {
  display: flex;
  gap: 16rpx;
}

.date-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #F5F8FA;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #6B6B6B;
  border: 2rpx solid transparent;
}

.date-item.active {
  background: rgba(139, 115, 85, 0.1);
  color: #5B8DEF;
  border-color: #5B8DEF;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #F5F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.borrow-tips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(232, 152, 94, 0.1);
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #5BCCF4;
  line-height: 1.4;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 48rpx;
}

.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: #F5F8FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6B6B6B;
}

.btn-confirm {
  flex: 2;
  text-align: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #5B8DEF 0%, #6B9CF1 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.loading-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F8FA;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B6B6B;
  font-size: 26rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.detail-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.detail-value.green {
  color: #5BDA95;
}

.detail-value.red {
  color: #FF6B6B;
}

.borrow-notice {
  background: #F5F8FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 12rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #6B6B6B;
  line-height: 1.8;
}

.book-meta {
  display: flex;
  gap: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}