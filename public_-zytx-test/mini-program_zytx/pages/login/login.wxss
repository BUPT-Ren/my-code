.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f8fa 100%);
  padding: 100rpx 60rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #5b8def, #667eea);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(91, 141, 239, 0.3);
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #2d2d2d;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #9e9e9e;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f8fa;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.input-icon {
  font-size: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-field {
  flex: 1;
  height: 88rpx;
  padding-right: 24rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9B9B9B;
}

.btn-login {
  background: linear-gradient(135deg, #5b8def, #667eea);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.btn-login[disabled] {
  opacity: 0.6;
}

.options-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.forgot-link {
  font-size: 26rpx;
  color: #5b8def;
}

.register-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #6b6b6b;
}

.link {
  color: #5b8def;
  margin-left: 10rpx;
  font-weight: 500;
}