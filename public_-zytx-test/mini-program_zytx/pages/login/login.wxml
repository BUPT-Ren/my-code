<view class="login-page">
  <view class="logo-section">
    <view class="logo">
      <text class="logo-icon">📚</text>
    </view>
    <text class="app-name">智阅同行</text>
    <text class="app-desc">让阅读成为生活的习惯</text>
  </view>

  <view class="form-section">
    <view class="input-group">
      <text class="input-icon">👤</text>
      <input 
        class="input-field" 
        placeholder="请输入用户名/邮箱/手机号" 
        placeholder-class="input-placeholder"
        value="{{identifier}}"
        bindinput="onIdentifierInput"
      />
    </view>

    <view class="input-group">
      <text class="input-icon">🔒</text>
      <input 
        class="input-field" 
        type="password" 
        placeholder="请输入密码" 
        placeholder-class="input-placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="options-row">
      <text class="forgot-link" bindtap="onForgotPassword">忘记密码？</text>
    </view>

    <button 
      class="btn-login" 
      bindtap="onLogin" 
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '登 录'}}
    </button>

    <view class="register-link">
      <text>还没有账号？</text>
      <text class="link" bindtap="onGoToRegister">立即注册</text>
    </view>
  </view>
</view>