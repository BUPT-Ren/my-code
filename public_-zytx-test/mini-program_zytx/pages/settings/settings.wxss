.page {
  min-height: 100vh;
  background: #F5F8FA;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(91, 141, 239, 0.08);
}

.header-left,
.header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 300;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8EEF5;
  border-top-color: #5B8DEF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B6B6B;
  font-size: 26rpx;
}

.settings-content {
  padding: 24rpx 32rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  background: #5B8DEF;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9B9B9B;
}

.form-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F8FA;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #2D2D2D;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #6B6B6B;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D2D2D;
  text-align: right;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-value {
  font-size: 28rpx;
  color: #2D2D2D;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #9B9B9B;
}

.picker-arrow {
  font-size: 32rpx;
  color: #9B9B9B;
  margin-left: 8rpx;
}

.hobby-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.section-tip {
  font-size: 22rpx;
  color: #9B9B9B;
  margin-bottom: 20rpx;
  display: block;
}

.hobby-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hobby-item {
  padding: 12rpx 24rpx;
  background: #F5F8FA;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6B6B6B;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.hobby-item.selected {
  background: rgba(91, 141, 239, 0.15);
  color: #5B8DEF;
  border-color: #5B8DEF;
}

.save-section {
  padding: 32rpx 0;
}

.save-btn {
  background: linear-gradient(135deg, #5B8DEF 0%, #7BA3F5 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 141, 239, 0.3);
}

.save-btn.disabled {
  opacity: 0.7;
}