<view class="page">
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="header-title">个人设置</text>
    <view class="header-right"></view>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="settings-content">
    <view class="avatar-section" bindtap="onChooseAvatar">
      <view class="avatar-wrap">
        <image wx:if="{{settings.avatar_url}}" src="{{settings.avatar_url}}" class="avatar-image" mode="aspectFill"/>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-text">{{settings.phone[0] || 'U'}}</text>
        </view>
        <view class="avatar-edit">
          <text>编辑</text>
        </view>
      </view>
      <text class="avatar-tip">点击更换头像</text>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="form-label">手机号</text>
        <text class="form-value">{{settings.phone}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">学校</text>
        <input 
          class="form-input" 
          placeholder="请输入学校名称"
          value="{{settings.school}}"
          data-field="school"
          bindinput="onInputChange"
        />
      </view>

      <view class="form-item">
        <text class="form-label">生日</text>
        <picker mode="date" value="{{settings.birthday}}" bindchange="onBirthdayChange">
          <view class="form-picker">
            <text class="{{settings.birthday ? 'picker-value' : 'picker-placeholder'}}">
              {{settings.birthday || '请选择生日'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="hobby-section">
      <view class="section-title">阅读偏好</view>
      <text class="section-tip">选择您感兴趣的图书类型（最多5个）</text>
      
      <view class="hobby-grid">
        <view 
          wx:for="{{hobbyOptions}}" 
          wx:key="*this" 
          class="hobby-item {{settings.hobbies.indexOf(item) > -1 ? 'selected' : ''}}"
          bindtap="onHobbyChange"
          data-hobby="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="save-section">
      <view class="save-btn {{saving ? 'disabled' : ''}}" bindtap="{{saving ? '' : 'onSave'}}">
        <text wx:if="{{saving}}">保存中...</text>
        <text wx:else>保存设置</text>
      </view>
    </view>
  </view>
</view>