<!--pages/ai-assistant/ai-assistant.wxml-->
<view class="page">
  <!-- 顶部提示 -->
  <view class="header-tip">
    <text class="tip-icon">💡</text>
    <text class="tip-text">AI 助手随时为你服务</text>
    <view class="clear-btn" bindtap="onClearHistory">
      <text>清空</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{scrollIntoView}}">
    <view class="messages-container">
      <view 
        wx:for="{{messages}}" 
        wx:key="id" 
        class="message-item {{item.type}}"
        id="msg-{{item.id}}"
      >
        <view class="avatar">
          <text wx:if="{{item.type === 'assistant'}}">🤖</text>
          <text wx:else>👤</text>
        </view>
        <view class="message-content">
          <text class="content-text">{{item.content}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
      </view>
      
      <!-- 正在输入 -->
      <view class="message-item assistant" wx:if="{{isTyping}}">
        <view class="avatar">
          <text>🤖</text>
        </view>
        <view class="message-content">
          <view class="typing-indicator">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{messages.length <= 2}}">
    <text class="quick-title">常见问题</text>
    <view class="quick-list">
      <view 
        wx:for="{{quickQuestions}}" 
        wx:key="id" 
        class="quick-item"
        bindtap="onQuickQuestion"
        data-question="{{item.question}}"
      >
        <text>{{item.question}}</text>
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input 
      class="message-input"
      placeholder="输入你的问题..."
      placeholder-class="input-placeholder"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="onSendMessage"
      confirm-type="send"
    />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="onSendMessage">
      <text>发送</text>
    </view>
  </view>
</view>